# Trip Concierge · environment template
# Copy to .env and fill in. `.env` is gitignored.

# ─── required ────────────────────────────────────────────────
GOOGLE_API_KEY=

# ─── optional · observability ────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-multiagent-orchestration

# ─── optional · model + voice overrides ──────────────────────
# Gemini Live model used by concierge-voice
GEMINI_LIVE_MODEL=gemini-3.1-flash-live
# Voice name for the Concierge (Gemini Live prebuilt voices:
#   Puck, Charon, Kore, Fenrir, Aoede)
CONCIERGE_VOICE_NAME=Charon

# Reasoning model used by Planner. Matches S5 ReasoningStrategy default.
# 3.x family supports thinking_level (enum). 2.5 family uses thinking_budget.
# If you pin a 2.5-family id, also set GEMINI_THINKING_LEGACY=1.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=medium

# ─── optional · logging ──────────────────────────────────────
LOG_LEVEL=INFO

# ─── frontend ─────────────────────────────────────────────────
# Only needed if running the frontend outside docker-compose.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/voice
NEXT_PUBLIC_PLAN_SSE_URL=http://localhost:8001/plan/stream
